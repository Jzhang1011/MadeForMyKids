{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WritingGymExercise",
  "type": "object",
  "required": [
    "id",
    "grade",
    "workoutType",
    "title",
    "prompt",
    "targetSkill",
    "fallbackHints",
    "localEvaluationRules"
  ],
  "properties": {
    "id": { "type": "string" },
    "grade": { "type": "integer", "enum": [3, 7] },
    "workoutType": {
      "type": "string",
      "enum": [
        "build_sentence",
        "add_detail",
        "sentence_surgery",
        "writing_detective",
        "build_paragraph",
        "claim_evidence_explanation",
        "build_argument",
        "read_like_a_writer"
      ]
    },
    "title": { "type": "string" },
    "targetSkill": {
      "type": "string",
      "enum": [
        "vocabulary",
        "sensory_details",
        "sentence_variety",
        "organization",
        "evidence",
        "explanation",
        "counterargument",
        "voice"
      ]
    },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "prompt": { "type": "string" },
    "scaffolding": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer" },
          "label": { "type": "string" },
          "question": { "type": "string" },
          "placeholder": { "type": "string" }
        },
        "required": ["step", "label"]
      }
    },
    "fallbackHints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "localEvaluationRules": {
      "type": "object",
      "properties": {
        "minWordCount": { "type": "integer" },
        "bannedWords": { "type": "array", "items": { "type": "string" } },
        "suggestedKeywords": { "type": "array", "items": { "type": "string" } },
        "requiresConnector": { "type": "boolean" }
      }
    }
  }
}